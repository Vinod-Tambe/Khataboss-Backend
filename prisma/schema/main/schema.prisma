// =============================================================================
// MODEL: Girvi
// =============================================================================

enum GirviRoiType {
  monthly
  annually
}

enum GirviType {
  unsecured
  secured
}

enum GirviStatus {
  ACTIVE
  RELEASED
  CLOSED
  TRANSFERRED
  AUCTION
}

enum GirviInterestMethod {
  simple
  compound
}

enum GirviCompoundFreq {
  monthly
  quarterly
  half_yearly
  yearly
}

model Girvi {
  girv_id       Int     @id @default(autoincrement())
  girv_uuid     String  @unique @default(uuid())
  girv_unique_code String? @unique
  girv_add_date String? @default("")

  girv_firm_id  Int @default(0)
  girv_own_id   Int @default(0)
  girv_user_id  Int @default(0)
  girv_staff_id Int @default(0)

  girv_start_date String

  girv_loan_no     String?
  girv_loan_pre_no String?

  girv_prin_amt    Float  @default(0)
  girv_process_per Float? @default(0)
  girv_process_amt Float? @default(0)

  girv_packet_no String?
  girv_locker_no String?

  girv_charge_per Float? @default(0)
  girv_charge_amt Float? @default(0)

  girv_roi      Float        @default(0)
  girv_roi_type GirviRoiType
  girv_type     GirviType

  girv_interest_method GirviInterestMethod @default(simple)
  girv_compound_freq   GirviCompoundFreq?

  girv_final_amt Float @default(0)

  girv_status GirviStatus @default(ACTIVE)

  girv_first_int           String? @default("N")
  girv_first_int_cr_acc_id Int?    @default(0)
  girv_first_int_dr_acc_id Int?    @default(0)

  girv_cash_amt   Float? @default(0)
  girv_bank_amt   Float? @default(0)
  girv_online_amt Float? @default(0)
  girv_card_amt   Float? @default(0)

  girv_cash_acc_id   Int? @default(0)
  girv_bank_acc_id   Int? @default(0)
  girv_online_acc_id Int? @default(0)
  girv_card_acc_id   Int? @default(0)

  girv_cash_info   String? @default("")
  girv_bank_info   String? @default("")
  girv_online_info String? @default("")
  girv_card_info   String? @default("")

  girv_dr_acc_id Int? @default(0)

  girv_other_info String? @default("")
  girv_pay_info   String? @default("")

  girv_transfer_firm_id Int?
  girv_transfer_girv_id Int?
  girv_transfer_ml_id   Int? // money lender on source loan when transferred to ML

  // Set on the NEW loan created in target firm (so Daybook can exclude from LOAN ADDED)
  girv_is_transferred_in     Boolean @default(false)
  girv_transfer_from_girv_id Int? // source loan id
  girv_transfer_from_firm_id Int? // source firm id

  // Audit Fields
  girv_created_at DateTime  @default(now())
  girv_created_by String?
  girv_updated_at DateTime  @updatedAt
  girv_updated_by String?
  girv_deleted_at DateTime?
  girv_deleted_by String?
  girv_is_deleted Boolean   @default(false)

  // Relations
  owner               Owner        @relation("OwnerGirvi", fields: [girv_own_id], references: [own_id], onDelete: Cascade)
  firm                Firm         @relation("FirmGirvi", fields: [girv_firm_id], references: [firm_id], onDelete: Cascade)
  user                User         @relation("UserGirvi", fields: [girv_user_id], references: [user_id], onDelete: Cascade)
  transferMoneyLender MoneyLender? @relation("GirviTransferMoneyLender", fields: [girv_transfer_ml_id], references: [ml_id], onDelete: SetNull)

  firstIntCrAccount Account? @relation("GirviFirstIntCrAccount", fields: [girv_first_int_cr_acc_id], references: [acc_id])
  firstIntDrAccount Account? @relation("GirviFirstIntDrAccount", fields: [girv_first_int_dr_acc_id], references: [acc_id])
  cashAccount       Account? @relation("GirviCashAccount", fields: [girv_cash_acc_id], references: [acc_id])
  bankAccount       Account? @relation("GirviBankAccount", fields: [girv_bank_acc_id], references: [acc_id])
  onlineAccount     Account? @relation("GirviOnlineAccount", fields: [girv_online_acc_id], references: [acc_id])
  cardAccount       Account? @relation("GirviCardAccount", fields: [girv_card_acc_id], references: [acc_id])
  drAccount         Account? @relation("GirviDrAccount", fields: [girv_dr_acc_id], references: [acc_id])

  additionalPrincipals AdditionalPrincipal[] @relation("GirviAP")
  deposits             GirviDeposit[]        @relation("GirviGirviDeposit")
  releases             GirviRelease[]        @relation("GirviGirviRelease")
  auctionLoans         AuctionLoan[]         @relation("GirviAuctionLoan")

  @@map("girvi")
}

