// =============================================================================
// Main Prisma Schema — per-tenant (main) database
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/main"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_MAIN_URL")
}

// =============================================================================

enum OwnerStatus {
  Active
  Inactive
}

model Owner {
  // ===============================
  // Primary Key
  // ===============================
  own_id          Int         @id @default(autoincrement())
  own_uuid        String      @unique @default(uuid())
  own_product_key Int         @unique @default(autoincrement())
  own_db          String      @unique
  // ===============================
  // Basic Information
  // ===============================
  own_add_date    DateTime    @default(now())
  own_first_name  String
  own_middle_name String?
  own_last_name   String
  own_phone_no    String?
  own_mobile_no   String      @unique
  own_email       String      @unique
  own_login_id    String      @unique
  own_password    String
  own_status      OwnerStatus @default(Active)
  own_profile_img Json?

  // ===============================
  // Authentication Details
  // ===============================
  own_refresh_token     String?
  own_refresh_expiry    DateTime?
  own_jwt_token         String?
  own_jwt_expiry        DateTime?
  own_login_status      Boolean   @default(false)
  own_last_login_system Json?
  own_otp               String?
  own_otp_expiry        DateTime?

  // ===============================
  // Outbound email (Gmail / SMTP) — owner configures after login
  // ===============================
  own_mail_user        String?
  own_mail_pass_enc    String?
  own_mail_from_name   String?   @default("Khataboss")
  own_mail_provider    String?   @default("gmail")
  own_mail_status      String?   @default("NotConfigured")
  own_mail_updated_at  DateTime?

  // ===============================
  // Address Information
  // ===============================
  own_address String?
  own_village String?
  own_city    String?
  own_state   String?
  own_pincode String?

  // ===============================
  // Audit Fields
  // ===============================
  own_created_at DateTime  @default(now())
  own_created_by String?
  own_updated_at DateTime  @updatedAt
  own_updated_by String?
  own_deleted_at DateTime?
  own_deleted_by String?
  own_is_deleted Boolean   @default(false)

  // ===============================
  // Relations
  // ===============================
  users    User[]    @relation("OwnerUser")
  firms    Firm[]    @relation("OwnerFirm")
  accounts Account[] @relation("OwnerAccount")

  finances             Finance[]                   @relation("OwnerFinance")
  financeTransactions  Finance_Transaction[]       @relation("OwnerFT")
  financeMoneyTrans    Finance_Money_Transaction[] @relation("OwnerFMT")
  journals             Journal[]                   @relation("OwnerJournal")
  journalTransactions  JournalTransaction[]        @relation("OwnerJRTR")
  girvis               Girvi[]                     @relation("OwnerGirvi")
  stocks               Stock[]                     @relation("OwnerStock")
  additionalPrincipals AdditionalPrincipal[]       @relation("OwnerAP")
  deposits             GirviDeposit[]              @relation("OwnerGirviDeposit")
  releases             GirviRelease[]              @relation("OwnerGirviRelease")
  rates                Rate[]                      @relation("OwnerRates")
  purities             Purity[]                    @relation("OwnerPurities")
  moneyLenders         MoneyLender[]               @relation("OwnerMoneyLenders")
  staff                Staff[]                     @relation("OwnerStaff")
  messageTemplates     MessageTemplate[]           @relation("OwnerMessageTemplate")
  formTemplates         FormTemplate[]              @relation("OwnerFormTemplate")
  whatsappInstances    WhatsAppInstance[]          @relation("OwnerWhatsAppInstance")

  // ===============================
  // Indexes
  // ===============================
  @@index([own_email])
  @@index([own_login_id])
}

// ===============================
// ENUMS
// ===============================

enum FirmType {
  Sole_Proprietorship
  Partnership
  LLP
  Private_Ltd
  Other
}

enum FirmBalanceType {
  DR
  CR
}

// ===============================
// MODEL: Firm
// ===============================

model Firm {
  // ===============================
  // Primary Key
  // ===============================
  firm_id       Int      @id @default(autoincrement())
  firm_uuid     String   @unique @default(uuid())
  firm_unique_code String? @unique
  // ===============================
  // Basic Information
  // ===============================
  firm_add_date DateTime @default(now())
  firm_own_id   Int      @default(1)

  firm_name      String  @unique
  firm_reg_no    String  @unique
  firm_shop_name String
  firm_desc      String?
  firm_address   String?
  firm_city      String?
  firm_pincode   String?

  firm_phone_no     String?
  firm_email_id     String?
  firm_website_link String?

  firm_type       FirmType @default(Other)
  firm_owner      String?
  firm_other_info String?

  // ===============================
  // Location
  // ===============================
  firm_geo_latitude  String?
  firm_geo_longitude String?

  // ===============================
  // Social Links
  // =============================== 
  firm_whatsapp_link String?
  firm_facebook_link String?
  firm_insta_link    String?

  // ===============================
  // Bank Details
  // ===============================
  firm_bank_name    String?
  firm_bank_acc_no  String?
  firm_bank_branch  String?
  firm_bank_address String?
  firm_acc_holder   String?
  firm_acc_type     String?
  firm_ifsc_code    String?

  // ===============================
  // Financial Information
  // ===============================
  firm_start_date   DateTime?
  firm_balance      String?         @default("0")
  firm_balance_type FirmBalanceType @default(CR)

  // ===============================
  // Tax Details
  // ===============================
  firm_gstin_no  String?
  firm_pan_no    String?
  firm_adhaar_no String?

  // ===============================
  // Invoice / Form Settings
  // ===============================
  firm_form_header    String?
  firm_form_footer    String?
  firm_own_sign_img   Json?
  firm_left_logo_img  Json?
  firm_right_logo_img Json?
  firm_qr_code_img    Json?
  firm_pan_no_img     Json?

  // ===============================
  // Audit Fields
  // ===============================

  firm_created_at DateTime @default(now())
  firm_created_by String?
  firm_updated_at DateTime @updatedAt
  firm_updated_by String?

  firm_deleted_at DateTime?
  firm_deleted_by String?
  firm_is_deleted Boolean   @default(false)

  // ===============================
  // Relations
  // ===============================
  users    User[]    @relation("FirmUser")
  accounts Account[] @relation("FirmAccount")
  owner    Owner     @relation("OwnerFirm", fields: [firm_own_id], references: [own_id], onDelete: Cascade)

  finances             Finance[]                   @relation("FinanceFirm")
  financeTransactions  Finance_Transaction[]
  financeMoneyTrans    Finance_Money_Transaction[]
  journals             Journal[]
  journalTransactions  JournalTransaction[]
  girvis               Girvi[]                     @relation("FirmGirvi")
  stocks               Stock[]                     @relation("FirmStock")
  additionalPrincipals AdditionalPrincipal[]       @relation("FirmAP")
  deposits             GirviDeposit[]              @relation("FirmGirviDeposit")
  releases             GirviRelease[]              @relation("FirmGirviRelease")
  rates                Rate[]                      @relation("FirmRates")
  moneyLenders         MoneyLender[]               @relation("FirmMoneyLenders")
  auctionUsers         AuctionUser[]               @relation("FirmAuctionUser")
  auctionLoans         AuctionLoan[]               @relation("FirmAuctionLoan")
  releaseUsers         ReleaseUser[]               @relation("FirmReleaseUser")
  messageTemplates     MessageTemplate[]           @relation("FirmMessageTemplate")
  formTemplate         FormTemplate?               @relation("FirmFormTemplate")
  whatsappInstance     WhatsAppInstance?           @relation("FirmWhatsAppInstance")
}

// Enum for balance type
enum AccountBalanceType {
  CR
  DR
}

model Account {
  acc_id       Int      @id @default(autoincrement())
  acc_uuid     String   @unique @default(uuid())
  acc_add_date DateTime @default(now())

  acc_own_id  Int @default(1)
  acc_firm_id Int @default(0)

  acc_pan_no      String? @db.VarChar(10)
  acc_name        String
  acc_desc        String?
  acc_pre_acc     String?
  acc_bank_no     String?
  acc_bsr_no      String?
  acc_ifsc_code   String? @db.VarChar(11)
  acc_branch_name String?

  acc_opening_date DateTime

  acc_address String?
  acc_country String?
  acc_state   String?
  acc_city    String?
  acc_pincode String? @db.VarChar(6)

  acc_cash_balance String?            @default("0")
  acc_balance_type AccountBalanceType @default(DR)

  acc_other_info String?

  // ===============================
  // Audit Fields
  // ===============================

  acc_created_at DateTime  @default(now())
  acc_created_by String?
  acc_updated_by String?
  acc_deleted_at DateTime?
  acc_deleted_by String?
  acc_is_system  Boolean   @default(false)
  acc_is_deleted Boolean   @default(false)

  owner Owner @relation("OwnerAccount", fields: [acc_own_id], references: [own_id], onDelete: Cascade)
  firm  Firm  @relation("FirmAccount", fields: [acc_firm_id], references: [firm_id], onDelete: Cascade)

  financeCash   Finance[] @relation("CashAccount")
  financeBank   Finance[] @relation("BankAccount")
  financeOnline Finance[] @relation("OnlineAccount")
  financeCard   Finance[] @relation("CardAccount")
  financeDr     Finance[] @relation("FinanceDrAccount")

  ftCash   Finance_Transaction[] @relation("FTCashAccount")
  ftBank   Finance_Transaction[] @relation("FTBankAccount")
  ftOnline Finance_Transaction[] @relation("FTOnlineAccount")
  ftCard   Finance_Transaction[] @relation("FTCardAccount")

  fmCash   Finance_Money_Transaction[] @relation("FMCashAccount")
  fmBank   Finance_Money_Transaction[] @relation("FMBankAccount")
  fmOnline Finance_Money_Transaction[] @relation("FMOnlineAccount")
  fmCard   Finance_Money_Transaction[] @relation("FMCardAccount")
  fmDr     Finance_Money_Transaction[] @relation("FMDrAccount")

  jrtrCredit JournalTransaction[] @relation("JournalCreditAccount")
  jrtrDebit  JournalTransaction[] @relation("JournalDebitAccount")

  girviFirstIntCr Girvi[] @relation("GirviFirstIntCrAccount")
  girviFirstIntDr Girvi[] @relation("GirviFirstIntDrAccount")
  girviCash       Girvi[] @relation("GirviCashAccount")
  girviBank       Girvi[] @relation("GirviBankAccount")
  girviOnline     Girvi[] @relation("GirviOnlineAccount")
  girviCard       Girvi[] @relation("GirviCardAccount")
  girviDr         Girvi[] @relation("GirviDrAccount")

  apCash   AdditionalPrincipal[] @relation("APCashAccount")
  apBank   AdditionalPrincipal[] @relation("APBankAccount")
  apOnline AdditionalPrincipal[] @relation("APOnlineAccount")
  apCard   AdditionalPrincipal[] @relation("APCardAccount")

  depPrin  GirviDeposit[] @relation("GirviDepositPrinAccount")
  depInt   GirviDeposit[] @relation("GirviDepositIntAccount")
  depDisc  GirviDeposit[] @relation("GirviDepositDiscAccount")
  depExtra GirviDeposit[] @relation("GirviDepositExtraAccount")

  depCash   GirviDeposit[] @relation("GirviDepositCashAccount")
  depBank   GirviDeposit[] @relation("GirviDepositBankAccount")
  depOnline GirviDeposit[] @relation("GirviDepositOnlineAccount")
  depCard   GirviDeposit[] @relation("GirviDepositCardAccount")

  relPrin  GirviRelease[] @relation("GirviReleasePrinAccount")
  relInt   GirviRelease[] @relation("GirviReleaseIntAccount")
  relDisc  GirviRelease[] @relation("GirviReleaseDiscAccount")
  relExtra GirviRelease[] @relation("GirviReleaseExtraAccount")

  relCash   GirviRelease[] @relation("GirviReleaseCashAccount")
  relBank   GirviRelease[] @relation("GirviReleaseBankAccount")
  relOnline GirviRelease[] @relation("GirviReleaseOnlineAccount")
  relCard   GirviRelease[] @relation("GirviReleaseCardAccount")
}

enum UserGender {
  Male
  Female
  Other
}

enum UserMaritalStatus {
  Single
  Married
  Divorced
  Widowed
  Other
}

// =============================================================================
// MODEL: User (NEW - CLEANED)
// =============================================================================

model User {
  user_id   Int    @id @default(autoincrement())
  user_uuid String @unique @default(uuid())
  user_unique_code String? @unique

  user_own_id  Int
  user_firm_id Int

  user_add_date DateTime @default(now())

  user_first_name  String
  user_father_name String?
  user_last_name   String
  user_mother_name String?

  user_mobile_no   String
  user_phone_no    String?
  user_whatsapp_no String?
  user_email_id    String?

  user_gender         UserGender?
  user_cast           String?
  user_marital_status UserMaritalStatus?
  user_occupation     String?

  user_birth_date DateTime?

  user_gstin     String?
  user_tax_no    String?
  user_pan_no    String? @db.VarChar(10)
  user_adhaar_no String? @db.VarChar(12)

  user_profile_img Json?

  user_per_address  String?
  user_curr_address String?

  user_village String?
  user_ward_no String?
  user_tehsil  String?
  user_city    String?
  user_state   String?
  user_country String?
  user_pincode String? @db.VarChar(6)

  user_bank_name   String?
  user_bank_acc_no String?
  user_ifsc_code   String? @db.VarChar(11)

  user_other_images Json?
  user_other_info String?

  // ===============================
  // Audit Fields
  // ===============================

  user_created_at DateTime  @default(now())
  user_created_by String?
  user_updated_at DateTime  @updatedAt
  user_updated_by String?
  user_deleted_at DateTime?
  user_deleted_by String?
  user_is_deleted Boolean   @default(false)

  // ===============================
  // Relations
  // ===============================

  owner Owner @relation("OwnerUser", fields: [user_own_id], references: [own_id], onDelete: Cascade)
  firm  Firm  @relation("FirmUser", fields: [user_firm_id], references: [firm_id], onDelete: Cascade)

  finances             Finance[]                   @relation("FinanceUser")
  financeTransactions  Finance_Transaction[]
  financeMoneyTrans    Finance_Money_Transaction[]
  journals             Journal[]
  journalTransactions  JournalTransaction[]
  girvis               Girvi[]                     @relation("UserGirvi")
  stocks               Stock[]                     @relation("UserStock")
  additionalPrincipals AdditionalPrincipal[]       @relation("UserAP")
  deposits             GirviDeposit[]              @relation("UserGirviDeposit")
  releases             GirviRelease[]              @relation("UserGirviRelease")

  @@index([user_mobile_no])
  @@index([user_email_id])
  @@index([user_firm_id])
}

enum FinanceStatus {
  ACTIVE
  INACTIVE
  PARTIAL
  CLOSED
  COMPLETED
}

enum FrequencyType {
  MONTHLY
  YEARLY
  WEEKLY
  DAILY
}

model Finance {
  fin_id       Int     @id @default(autoincrement())
  fin_uuid     String  @unique @default(uuid())
  fin_unique_code String? @unique
  fin_add_date String? @default("")
  fin_own_id   Int     @default(0)
  fin_firm_id  Int     @default(0)
  fin_user_id  Int     @default(0)
  fin_jrnl_id  Int?    @default(0)
  fin_staff_id Int     @default(0)

  fin_prin_amt   Float
  fin_no_of_emi  Int
  fin_start_date String

  fin_time_period  String?       @default("")
  fin_sms_period   String?       @default("")
  fin_freq_type    FrequencyType @default(MONTHLY)
  fin_freq         String?       @default("")
  fin_roi          String?       @default("")
  fin_status       FinanceStatus @default(ACTIVE)
  fin_collec_amt   Float?        @default(0)
  fin_proccess_amt Float?        @default(0)
  fin_fine_amt     Float?        @default(0)
  fin_fine_emi_no  Int?          @default(0)
  fin_emi_amt      Float?        @default(0)

  fin_final_amt Float

  fin_cash_amt   String? @default("")
  fin_bank_amt   String? @default("")
  fin_online_amt String? @default("")
  fin_card_amt   String? @default("")

  fin_cash_acc_id   Int? @default(0)
  fin_bank_acc_id   Int? @default(0)
  fin_online_acc_id Int? @default(0)
  fin_card_acc_id   Int? @default(0)

  fin_cash_info   String? @default("")
  fin_bank_info   String? @default("")
  fin_online_info String? @default("")
  fin_card_info   String? @default("")
  fin_dr_acc_id   Int?    @default(0)

  fin_pay_info   String? @default("")
  fin_other_info String? @default("")

  // Audit Fields
  fin_created_at DateTime  @default(now())
  fin_created_by String?
  fin_updated_at DateTime  @default(now())
  fin_updated_by String?
  fin_deleted_at DateTime?
  fin_deleted_by String?
  fin_is_deleted Boolean   @default(false)

  // Relations
  firm                Firm                        @relation("FinanceFirm", fields: [fin_firm_id], references: [firm_id], onDelete: Cascade)
  user                User                        @relation("FinanceUser", fields: [fin_user_id], references: [user_id], onDelete: Cascade)
  finance_trans       Finance_Transaction[]
  finance_money_trans Finance_Money_Transaction[]
  cashAccount         Account?                    @relation("CashAccount", fields: [fin_cash_acc_id], references: [acc_id])
  bankAccount         Account?                    @relation("BankAccount", fields: [fin_bank_acc_id], references: [acc_id])
  onlineAccount       Account?                    @relation("OnlineAccount", fields: [fin_online_acc_id], references: [acc_id])
  cardAccount         Account?                    @relation("CardAccount", fields: [fin_card_acc_id], references: [acc_id])
  drAccount           Account?                    @relation("FinanceDrAccount", fields: [fin_dr_acc_id], references: [acc_id])

  owner Owner @relation("OwnerFinance", fields: [fin_own_id], references: [own_id], onDelete: Cascade)

  @@map("finance")
}

enum EmiStatus {
  PAID
  PENDING
  PARTIAL
  DUE
}

model Finance_Transaction {
  ft_id      Int    @id @default(autoincrement())
  ft_uuid    String @unique @default(uuid())
  // ================================
  // 🔗 Foreign Keys
  // ================================
  ft_firm_id Int
  ft_own_id  Int
  ft_user_id Int
  ft_fin_id  Int

  // Account Foreign Keys
  ft_cash_acc_id   Int?
  ft_bank_acc_id   Int?
  ft_online_acc_id Int?
  ft_card_acc_id   Int?

  // ================================
  // EMI Details
  // ================================

  ft_emi_no     Int
  ft_add_date   String? @default("")
  ft_start_date String
  ft_due_date   String
  ft_paid_date  String?

  ft_emi_amt     Float
  ft_fine_amt    Float @default(0)
  ft_paid_amt    Float
  ft_pending_amt Float

  ft_emi_status EmiStatus @default(PENDING)

  // Audit Fields
  ft_created_at DateTime  @default(now())
  ft_created_by String?
  ft_updated_at DateTime  @default(now())
  ft_updated_by String?
  ft_deleted_at DateTime?
  ft_deleted_by String?
  ft_is_deleted Boolean   @default(false)

  // ================================
  // 🔗 Relations
  // ================================

  firm    Firm    @relation(fields: [ft_firm_id], references: [firm_id], onDelete: Cascade)
  user    User    @relation(fields: [ft_user_id], references: [user_id], onDelete: Cascade)
  owner   Owner   @relation("OwnerFT", fields: [ft_own_id], references: [own_id], onDelete: Cascade)
  finance Finance @relation(fields: [ft_fin_id], references: [fin_id], onDelete: Cascade)

  cashAccount   Account? @relation("FTCashAccount", fields: [ft_cash_acc_id], references: [acc_id])
  bankAccount   Account? @relation("FTBankAccount", fields: [ft_bank_acc_id], references: [acc_id])
  onlineAccount Account? @relation("FTOnlineAccount", fields: [ft_online_acc_id], references: [acc_id])
  cardAccount   Account? @relation("FTCardAccount", fields: [ft_card_acc_id], references: [acc_id])

  @@map("finance_trans")
}

enum BalanceType {
  CR
  DR
}

model Finance_Money_Transaction {
  fm_id   Int    @id @default(autoincrement())
  fm_uuid String @unique @default(uuid())
  // ===============================
  // 🔗 Foreign Keys
  // ===============================

  fm_firm_id Int
  fm_own_id  Int
  fm_user_id Int
  fm_fin_id  Int
  fm_jrnl_id Int?

  fm_cash_acc_id   Int?
  fm_bank_acc_id   Int?
  fm_online_acc_id Int?
  fm_card_acc_id   Int?
  fm_dr_acc_id     Int?

  // ===============================
  // Transaction Info
  // ===============================

  fm_add_date    String?     @default("")
  fm_trans_crdr  BalanceType
  fm_trans_date  String
  fm_trans_panel String?     @default("")
  fm_trans_type  String?     @default("")

  fm_trans_amt Float

  fm_cash_amt   Float @default(0)
  fm_bank_amt   Float @default(0)
  fm_online_amt Float @default(0)
  fm_card_amt   Float @default(0)

  fm_cash_info   String? @default("")
  fm_bank_info   String? @default("")
  fm_online_info String? @default("")
  fm_card_info   String? @default("")

  fm_pay_info   String? @default("")
  fm_other_info String? @default("")

  // Audit Fields
  fm_created_at DateTime  @default(now())
  fm_created_by String?
  fm_updated_by String?
  fm_updated_at DateTime  @default(now())
  fm_deleted_at DateTime?
  fm_deleted_by String?
  fm_is_deleted Boolean   @default(false)

  // ===============================
  // 🔗 Relations
  // ===============================

  firm    Firm     @relation(fields: [fm_firm_id], references: [firm_id], onDelete: Cascade)
  user    User     @relation(fields: [fm_user_id], references: [user_id], onDelete: Cascade)
  owner   Owner    @relation("OwnerFMT", fields: [fm_own_id], references: [own_id], onDelete: Cascade)
  finance Finance  @relation(fields: [fm_fin_id], references: [fin_id], onDelete: Cascade)
  journal Journal? @relation(fields: [fm_jrnl_id], references: [jrnl_id])

  cashAccount   Account? @relation("FMCashAccount", fields: [fm_cash_acc_id], references: [acc_id])
  bankAccount   Account? @relation("FMBankAccount", fields: [fm_bank_acc_id], references: [acc_id])
  onlineAccount Account? @relation("FMOnlineAccount", fields: [fm_online_acc_id], references: [acc_id])
  cardAccount   Account? @relation("FMCardAccount", fields: [fm_card_acc_id], references: [acc_id])
  drAccount     Account? @relation("FMDrAccount", fields: [fm_dr_acc_id], references: [acc_id])

  @@map("finance_money_trans")
}

model Journal {
  jrnl_id   Int    @id @default(autoincrement())
  jrnl_uuid String @unique @default(uuid())
  // ============================
  // 🔗 Foreign Keys
  // ============================

  jrnl_firm_id Int
  jrnl_own_id  Int
  jrnl_user_id Int?

  // ============================
  // Journal Info
  // ============================

  jrnl_add_date   String? @default("")
  jrnl_date       String
  jrnl_amt        Float
  jrnl_panel      String
  jrnl_other_info String? @default("")

  // ============================
  // Reverse Relations
  // ============================

  financeMoneyTransactions Finance_Money_Transaction[]

  // Audit Fields
  jrnl_created_at DateTime  @default(now())
  jrnl_created_by String?
  jrnl_updated_by String?
  jrnl_updated_at DateTime  @default(now())
  jrnl_deleted_at DateTime?
  jrnl_deleted_by String?
  jrnl_is_deleted Boolean   @default(false)

  // ===============================
  // 🔗 Relations
  // ===============================

  firm                Firm                 @relation(fields: [jrnl_firm_id], references: [firm_id], onDelete: Cascade)
  user                User?                @relation(fields: [jrnl_user_id], references: [user_id], onDelete: Cascade)
  owner               Owner                @relation("OwnerJournal", fields: [jrnl_own_id], references: [own_id], onDelete: Cascade)
  journalTransactions JournalTransaction[]

  @@map("journal")
}

enum BalanceAmtType {
  CR
  DR
}

model JournalTransaction {
  jrtr_id   Int    @id @default(autoincrement())
  jrtr_uuid String @unique @default(uuid())
  // ===============================
  // 🔗 Foreign Keys
  // ===============================

  jrtr_jrnl_id Int
  jrtr_firm_id Int
  jrtr_own_id  Int
  jrtr_user_id Int?

  jrtr_cr_acc_id Int?
  jrtr_dr_acc_id Int?

  // ===============================
  // Transaction Info
  // ===============================

