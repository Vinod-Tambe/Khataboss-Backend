  al_other_info     String?

  // Relations
  firm              Firm        @relation("FirmAuctionLoan", fields: [al_firm_id], references: [firm_id], onDelete: Cascade)
  girvi             Girvi       @relation("GirviAuctionLoan", fields: [al_girv_id], references: [girv_id], onDelete: Cascade)
  buyer             AuctionUser @relation("AuctionUserAuctionLoan", fields: [al_buyer_id], references: [au_id], onDelete: Cascade)

  @@map("auction_loans")
}

// =============================================================================
// STAFF & PERMISSIONS
// =============================================================================

enum StaffStatus {
  Active
  Inactive
}

enum StaffGender {
  Male
  Female
  Other
}

enum StaffMaritalStatus {
  Single
  Married
  Divorced
  Widowed
  Other
}

/// Staff login ID is stored as the staff-only part (e.g. "dev").
/// Full app login is: owner_login_id + "+" + staff_login_id (e.g. "admin+dev").
model Staff {
  staff_id   Int    @id @default(autoincrement())
  staff_uuid String @unique @default(uuid())
  staff_unique_code String? @unique

  staff_own_id  Int
  staff_add_date DateTime @default(now())

  staff_first_name  String
  staff_last_name   String
  staff_father_name String?
  staff_mother_name String?

  staff_mobile_no String
  staff_phone_no  String?
  staff_email_id  String?

  staff_gender         StaffGender?
  staff_cast           String?
  staff_marital_status StaffMaritalStatus?
  staff_occupation     String?
  staff_birth_date     DateTime?

  staff_gstin     String?
  staff_tax_no    String?
  staff_pan_no    String? @db.VarChar(10)
  staff_adhaar_no String? @db.VarChar(12)

  staff_login_id String  @unique
  staff_password String
  staff_status   StaffStatus @default(Active)

  staff_profile_img  Json?
  staff_other_images Json?

  staff_per_address  String?
  staff_curr_address String?
  staff_village      String?
  staff_ward_no      String?
  staff_tehsil       String?
  staff_city         String?
  staff_state        String?
  staff_country      String?
  staff_pincode      String? @db.VarChar(6)

  staff_bank_name   String?
  staff_bank_acc_no String?
  staff_ifsc_code   String? @db.VarChar(11)
  staff_other_info  String?

  staff_refresh_token     String?
  staff_jwt_token         String?
  staff_login_status      Boolean @default(false)
  staff_last_login_system Json?
  staff_otp               String?
  staff_otp_expiry        DateTime?

  staff_created_at DateTime  @default(now())
  staff_created_by String?
  staff_updated_at DateTime  @updatedAt
  staff_updated_by String?
  staff_deleted_at DateTime?
  staff_deleted_by String?
  staff_is_deleted Boolean   @default(false)

  owner       Owner             @relation("OwnerStaff", fields: [staff_own_id], references: [own_id], onDelete: Cascade)
  permissions StaffPermission[]

  @@index([staff_login_id])
  @@index([staff_mobile_no])
  @@index([staff_email_id])
  @@index([staff_status])
  @@map("staff")
}

model Permission {
  perm_id         Int      @id @default(autoincrement())
  perm_key        String   @unique // e.g. firm.view
  perm_module     String // e.g. firm
  perm_action     String // e.g. view
  perm_label      String
  perm_sort_order Int      @default(0)
  perm_created_at DateTime @default(now())
  perm_updated_at DateTime @updatedAt

  staffPermissions StaffPermission[]

  @@index([perm_module])
  @@map("permissions")
}

model StaffPermission {
  sp_id         Int      @id @default(autoincrement())
  sp_staff_id   Int
  sp_perm_id    Int
  sp_granted    Boolean  @default(true)
  sp_created_at DateTime @default(now())
  sp_updated_at DateTime @updatedAt

  staff      Staff      @relation(fields: [sp_staff_id], references: [staff_id], onDelete: Cascade)
  permission Permission @relation(fields: [sp_perm_id], references: [perm_id], onDelete: Cascade)

  @@unique([sp_staff_id, sp_perm_id])
  @@index([sp_staff_id])
  @@index([sp_perm_id])
  @@map("staff_permissions")
}

// =============================================================================
// SerialNumber Model
// =============================================================================
model SerialNumber {
  sn_id          Int      @id @default(autoincrement())
  entity_type    String   @unique
  start_number   Int      @default(1001)
  current_number Int      @default(1000)
  number_prefix  String   @default("")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("serial_numbers")
}

// =============================================================================
// Messaging — Email / WhatsApp / Text SMS templates (firm-wise)
// =============================================================================

enum MessageChannel {
  whatsapp
  sms
  email
}

enum MessageTemplateStatus {
  Active
  Inactive
}

enum WhatsAppInstanceStatus {
  Pending
  Connected
  Disconnected
  Error
}

model MessageTemplate {
  mt_id             Int                   @id @default(autoincrement())
  mt_uuid           String                @unique @default(uuid())
  mt_own_id         Int
  mt_firm_id        Int
  mt_channel        MessageChannel
  mt_key            String
  mt_name           String
  mt_category       String                @default("Transactional")
  mt_language       String                @default("English (US)")
  mt_subject        String?
  mt_body           String
  mt_variables      Json?
  mt_attachments    Json?
  mt_has_attachment Boolean               @default(false)
  mt_is_system      Boolean               @default(false)
  mt_status         MessageTemplateStatus @default(Active)

  mt_created_at DateTime  @default(now())
  mt_created_by String?
  mt_updated_at DateTime  @updatedAt
  mt_updated_by String?
  mt_deleted_at DateTime?
  mt_deleted_by String?
  mt_is_deleted Boolean   @default(false)

  owner Owner @relation("OwnerMessageTemplate", fields: [mt_own_id], references: [own_id], onDelete: Cascade)
  firm  Firm  @relation("FirmMessageTemplate", fields: [mt_firm_id], references: [firm_id], onDelete: Cascade)

  @@unique([mt_firm_id, mt_channel, mt_name])
  @@index([mt_own_id, mt_firm_id, mt_channel])
  @@index([mt_key])
  @@map("message_templates")
}

enum FormTemplateStatus {
  Active
  Inactive
}

model FormTemplate {
  ft_id         Int                @id @default(autoincrement())
  ft_uuid       String             @unique @default(uuid())
  ft_own_id     Int
  ft_firm_id    Int                @unique
  ft_config     Json
  ft_status     FormTemplateStatus @default(Active)
  ft_is_system  Boolean            @default(true)

  ft_created_at DateTime  @default(now())
  ft_created_by String?
  ft_updated_at DateTime  @updatedAt
  ft_updated_by String?
  ft_deleted_at DateTime?
  ft_deleted_by String?
  ft_is_deleted Boolean   @default(false)

  owner Owner @relation("OwnerFormTemplate", fields: [ft_own_id], references: [own_id], onDelete: Cascade)
  firm  Firm  @relation("FirmFormTemplate", fields: [ft_firm_id], references: [firm_id], onDelete: Cascade)

  @@index([ft_own_id, ft_firm_id])
  @@map("form_templates")
}

model WhatsAppInstance {
  wa_id           Int                    @id @default(autoincrement())
  wa_uuid         String                 @unique @default(uuid())
  wa_own_id       Int
  wa_firm_id      Int                    @unique
  wa_provider     String                 @default("ultramsg")
  wa_instance_id  String?
  wa_token        String?
  wa_api_url      String?
  wa_phone_number String?
  wa_status       WhatsAppInstanceStatus @default(Pending)
  wa_qr_code      String?
  wa_last_checked DateTime?
  wa_meta         Json?

  wa_created_at DateTime  @default(now())
  wa_created_by String?
  wa_updated_at DateTime  @updatedAt
  wa_updated_by String?
  wa_deleted_at DateTime?
  wa_deleted_by String?
  wa_is_deleted Boolean   @default(false)

  owner Owner @relation("OwnerWhatsAppInstance", fields: [wa_own_id], references: [own_id], onDelete: Cascade)
  firm  Firm  @relation("FirmWhatsAppInstance", fields: [wa_firm_id], references: [firm_id], onDelete: Cascade)

  @@index([wa_own_id])
  @@index([wa_status])
  @@map("whatsapp_instances")
}

model MessageLog {
  ml_id           Int            @id @default(autoincrement())
  ml_uuid         String         @unique @default(uuid())
  ml_own_id       Int
  ml_firm_id      Int
  ml_channel      MessageChannel
  ml_template_key String
  ml_to           String
  ml_status       String
  ml_error        String?
  ml_meta         Json?
  ml_created_at   DateTime       @default(now())

  @@index([ml_firm_id, ml_template_key])
  @@index([ml_created_at])
  @@map("message_logs")
}

model ActivityLog {
  al_id          Int      @id @default(autoincrement())
  al_uuid        String   @unique @default(uuid())
  al_own_id      Int
  al_firm_id     Int
  al_module      String
  al_action      String
  al_subject     String
  al_description String   @db.Text
  al_entity_type String?
  al_entity_id   Int?
  al_ref_no      String?
  al_amount      Decimal? @db.Decimal(18, 2)
  al_login_id    String
  al_meta        Json?
  al_created_at  DateTime @default(now())

  @@index([al_firm_id, al_created_at(sort: Desc)])
  @@index([al_firm_id, al_entity_type, al_entity_id])
  @@index([al_own_id, al_created_at(sort: Desc)])
  @@map("activity_logs")
}

