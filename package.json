    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "migrate": "^2.1.0",
    "multer": "^2.1.1",
    "ngrok": "^5.0.0-beta.2",
    "nodemailer": "^8.0.4",
    "pg": "^8.14.1",
    "pino": "^10.3.1",
