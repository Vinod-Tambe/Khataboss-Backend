{
  "name": "master",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "uat": "ngrok http 9000",
    "udb": "node scripts/bootstrap.js",
    "migrate": "prisma migrate deploy --schema=prisma/schema/master/schema.prisma",
    "generate": "prisma generate --schema=prisma/schema/master/schema.prisma",
    "generate:main": "prisma generate --schema=prisma/schema/main/schema.prisma",
    "seed": "node -e \"require('./config/db'); const s = require('./prisma/seeder/admin-seeder'); s.seedAdmin().then(() => s.seedDbSeries()).then(() => s.seedAllTenantsSerialNumbers())\"",
    "sync": "node scripts/sync-tenants.js"
  },
