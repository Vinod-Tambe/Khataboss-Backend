{
  "name": "master",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "uat": "npx --yes ngrok@5.0.0-beta.2 http 9000",
    "udb": "node scripts/bootstrap.js",
    "migrate": "prisma migrate deploy --schema=prisma/schema/master/schema.prisma",
    "generate": "prisma generate --schema=prisma/schema/master/schema.prisma",
    "generate:main": "prisma generate --schema=prisma/schema/main/schema.prisma",
    "seed": "node -e \"require('./config/db'); const s = require('./prisma/seeder/admin-seeder'); s.seedAdmin().then(() => s.seedDbSeries()).then(() => s.seedPlans()).then(() => s.seedAllTenantsSerialNumbers())\"",
    "seed:plans": "node -e \"require('./config/db'); require('./prisma/seeder/plan-seeder').seedPlans()\"",
    "seed:announcements": "node -e \"require('./config/db'); require('./prisma/seeder/announcement-template-seeder').seedAnnouncementTemplates()\"",
    "sync": "node scripts/sync-tenants.js"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "migrate": "^2.1.0",
    "multer": "^2.2.1",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.14.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^5.22.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.12",
    "http-cache-semantics": "4.2.0",
    "js-yaml": "4.3.2",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "sharp": "0.35.4"
  }
}
